MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/circle?authSource=admin
TEST_MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/circle_tests?authSource=admin

# Must match the exact address opened in the browser during local development.
PUBLIC_ORIGIN=http://localhost:3000
COMMONS_ORIGIN=https://class.mit-sdg.dev
# On the course platform, use PUBLIC_ORIGIN=https://circle.mit-sdg.dev

# P3: explicitly enable OpenAI extraction for newly saved/retried notes.
# local keeps the P2 parser. No automatic fallback or bulk reindexing.
GRAPHING_EXTRACTOR=local
# Required only for openai; keep the API key on the server, never in VITE_ variables.
OPENAI_API_KEY=
OPENAI_GRAPH_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
